# Required: Metra GTFS API credentials.
# Apply at https://metra.com/metra-gtfs-api
METRA_API_TOKEN=your-api-token-here

# Optional: HTTP server bind address (only used with --sse / --http)
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Optional: SQLite path for the /stats dashboard.
# Default: $STATE_DIRECTORY/stats.db under systemd, else /var/lib/metra-mcp/stats.db
# METRA_STATS_DB=/var/lib/metra-mcp/stats.db

# Optional: where the GTFS schedule zip is cached.
# Default: $STATE_DIRECTORY/cache under systemd, else ~/.cache/metra-mcp
# METRA_CACHE_DIR=/var/lib/metra-mcp/cache

# Optional: enables the /copilot web chat UI by proxying to the Anthropic API.
# Without this, /copilot loads but cannot return answers.
ANTHROPIC_API_KEY=

# Optional: public URL the Anthropic API uses to call back into this MCP
# server. Auto-detected from the request when running behind a reverse proxy
# that sets X-Forwarded-Proto + Host. Override if auto-detection is wrong.
# METRA_PUBLIC_MCP_URL=https://metra.example.com/mcp

# Optional: how often (seconds) to re-check the published GTFS schedule.
# METRA_REFRESH_INTERVAL_SEC=21600

# Optional: TTL (seconds) for the in-memory cache of realtime feeds
# (positions / trip updates / alerts). 0 disables caching.
# METRA_RT_CACHE_TTL_SEC=20

# Optional: abuse guards for the /api/chat proxy. Per client IP:
# METRA_CHAT_RATE_MAX=20
# METRA_CHAT_RATE_WINDOW_SEC=60
# ...and a global rolling-24h cap across all callers (0 disables). The proxy
# spends YOUR Anthropic key, so also set a spend limit in the Anthropic Console.
# METRA_CHAT_GLOBAL_DAILY_MAX=400
# Default model for the copilot (must be on the server's allowlist).
# METRA_CHAT_MODEL=claude-sonnet-5

# Optional: comma-separated IPs/CIDRs allowed to set forwarding headers
# (X-Forwarded-For / X-Real-IP / CF-Connecting-IP). Default: loopback only.
# METRA_TRUSTED_PROXIES=127.0.0.1,::1
# Pin which forwarding header to trust (recommended). cloudflared/Cloudflare
# set cf-connecting-ip authoritatively; nginx typically sets x-real-ip.
# METRA_CLIENT_IP_HEADER=cf-connecting-ip

# Optional: Host allowlist for the MCP endpoints (DNS-rebinding / Host-spoof
# protection). Comma-separated; "host:*" matches any port. Empty = disabled.
# METRA_ALLOWED_HOSTS=metra.example.com,localhost:*

# Optional: re-enable the deprecated HTTP+SSE transport on /sse + /messages/.
# METRA_ENABLE_LEGACY_SSE=0

# Optional: token unlocking client IPs / user-agents on /api/stats.
# Without it (or without the token supplied), those fields are redacted.
# Visit /stats?token=<value> to see full detail.
# METRA_STATS_TOKEN=
